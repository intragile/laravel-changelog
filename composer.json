{
    "name": "intragile/laravel-changelog",
    "description": "Serves a Laravel app's Keep a Changelog CHANGELOG.md, with per-locale translations, over a JSON API, and checks the file with an artisan command.",
    "keywords": [
        "laravel",
        "changelog",
        "keep-a-changelog",
        "release-notes",
        "markdown",
        "api",
        "i18n",
        "változásnapló",
        "kiadási jegyzet"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/laravel-changelog/issues",
        "source": "https://github.com/intragile/laravel-changelog",
        "security": "https://github.com/intragile/laravel-changelog/security/policy"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "league/commonmark": "^2.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "illuminate/support": "<12.0"
    },
    "autoload": {
        "psr-4": {
            "IntrAgile\\Changelog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\Changelog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IntrAgile\\Changelog\\ChangelogServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
